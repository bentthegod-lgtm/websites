local H = require("./helpers")
local Timers = require("../src/shared/Timers")
local GameConfig = require("../src/shared/Config/GameConfig")
local cases, test = H.suite("Timers")
local L = GameConfig.Lock

test("lock lasts 45s then cooldown 60s", function()
	local lock = Timers.newLock()
	H.eq(Timers.lockStatus(lock, 100), "Ready")
	assert(Timers.tryLock(lock, 100, L, false))
	local status, left = Timers.lockStatus(lock, 110)
	H.eq(status, "Locked")
	H.near(left, 35)
	local ok, why = Timers.tryLock(lock, 120, L, false)
	assert(not ok and why == "Already locked")
	status, left = Timers.lockStatus(lock, 150)
	H.eq(status, "Cooldown")
	H.near(left, 55)
	ok, why = Timers.tryLock(lock, 150, L, false)
	assert(not ok and why == "Cooldown")
	H.eq(Timers.lockStatus(lock, 205), "Ready")
	assert(Timers.tryLock(lock, 205, L, false))
end)

test("paid lock skips cooldown but never chains back to back", function()
	local lock = Timers.newLock()
	assert(Timers.tryLock(lock, 0, L, false))
	assert(not Timers.canPaidLock(lock, 10, L), "cannot pay while locked")
	assert(not Timers.tryLock(lock, 10, L, true))
	assert(not Timers.canPaidLock(lock, 46, L), "must stay open for a moment")
	local ok, why = Timers.tryLock(lock, 46, L, true)
	assert(not ok and why == "Too soon")
	assert(Timers.canPaidLock(lock, 45 + L.MinGapAfterPaid, L))
	assert(Timers.tryLock(lock, 45 + L.MinGapAfterPaid, L, true))
	H.eq(Timers.lockStatus(lock, 60), "Locked")
	assert(Timers.canPaidLock(Timers.newLock(), 5, L), "a never-locked base can pay-lock")
end)

test("daily streak continues, resets and wraps", function()
	local canClaim, streak, index = Timers.dailyStatus({ LastDay = 0, Streak = 0 }, 500, 7)
	assert(canClaim and streak == 1 and index == 1)
	canClaim, streak, index = Timers.dailyStatus({ LastDay = 499, Streak = 3 }, 500, 7)
	assert(canClaim and streak == 4 and index == 4)
	canClaim, streak = Timers.dailyStatus({ LastDay = 500, Streak = 4 }, 500, 7)
	assert(not canClaim and streak == 4)
	canClaim, streak = Timers.dailyStatus({ LastDay = 497, Streak = 6 }, 500, 7)
	assert(canClaim and streak == 1, "missed days reset the streak")
	canClaim, streak, index = Timers.dailyStatus({ LastDay = 499, Streak = 7 }, 500, 7)
	assert(canClaim and streak == 8 and index == 1, "day 8 wraps to reward 1")
	H.eq(Timers.dayIndex(86400 * 3 + 5), 3)
	H.eq(Timers.secondsUntilNextDay(86400 * 3 + 400), 86000)
end)

test("admin event phase cycles every 15 minutes", function()
	local E = GameConfig.Events
	local p = Timers.adminPhase(0, E)
	assert(not p.active and p.nextIn == E.FirstAdminDelay)
	p = Timers.adminPhase(E.FirstAdminDelay + 10, E)
	assert(p.active and p.cycle == 0 and p.remaining == E.AdminDuration - 10)
	p = Timers.adminPhase(E.FirstAdminDelay + E.AdminDuration + 1, E)
	assert(not p.active and p.nextIn == E.AdminInterval - E.AdminDuration - 1)
	p = Timers.adminPhase(E.FirstAdminDelay + E.AdminInterval * 3 + 5, E)
	assert(p.active and p.cycle == 3)
end)

test("lucky hour is the first minutes of every hour", function()
	local active, left = Timers.luckyHour(3600 * 10 + 60, 10)
	assert(active and left == 540)
	active, left = Timers.luckyHour(3600 * 10 + 900, 10)
	assert(not active and left == 2700)
end)

test("server luck time stacks up to a cap", function()
	local untilT = Timers.extendUntil(0, 1000, 900, 7200)
	H.eq(untilT, 1900)
	untilT = Timers.extendUntil(untilT, 1100, 900, 7200)
	H.eq(untilT, 2800)
	for _ = 1, 20 do
		untilT = Timers.extendUntil(untilT, 1100, 900, 7200)
	end
	H.eq(untilT, 1100 + 7200)
end)

return cases
