local H = require("./helpers")
local Format = require("../src/shared/Format")
local cases, test = H.suite("Format")

test("short numbers and suffixes", function()
	H.eq(Format.short(0), "0")
	H.eq(Format.short(999), "999")
	H.eq(Format.short(1000), "1K")
	H.eq(Format.short(1250), "1.25K")
	H.eq(Format.short(12500), "12.5K")
	H.eq(Format.short(125000), "125K")
	H.eq(Format.short(100000), "100K")
	H.eq(Format.short(10000), "10K")
	H.eq(Format.short(5500000), "5.5M")
	H.eq(Format.short(2e9), "2B")
	H.eq(Format.short(-1500), "-1.5K")
end)

test("never rounds up past the real value", function()
	H.eq(Format.short(1999), "1.99K")
	H.eq(Format.short(999999), "999K")
end)

test("handles NaN and non-numbers", function()
	H.eq(Format.short(0 / 0), "0")
	H.eq(Format.short(nil), "0")
	H.eq(Format.cash(2500), "$2.5K")
	H.eq(Format.perSecond(12), "$12/s")
end)

test("commas and time", function()
	H.eq(Format.commas(1234567), "1,234,567")
	H.eq(Format.commas(123), "123")
	H.eq(Format.time(75), "1:15")
	H.eq(Format.time(3725), "1:02:05")
	H.eq(Format.time(-4), "0:00")
end)

return cases
